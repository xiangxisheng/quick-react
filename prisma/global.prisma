datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model global_sites {
  id               Int     @id @default(autoincrement())
  site_key         String  @unique
  name             String
  base_site_key    String?
  dsn              String  @default("")
  dsn_password     String?
  database_binding String  @default("")
  status           String  @default("enabled")
  migration_status String  @default("ready")
  is_default       Int     @default(0)
  is_system        Int     @default(0)
}

model global_site_hosts {
  id         Int    @id @default(autoincrement())
  hostname   String @unique
  site_key   String
  status     String @default("enabled")
  created_at Int
}

model global_cloud_credentials {
  id                Int    @id @default(autoincrement())
  name              String @unique
  provider          String
  account_id        String @default("")
  access_key_id     String @default("")
  access_key_secret String @default("")
  status            String @default("enabled")
  created_at        Int
  updated_at        Int
}

model global_cloud_object_storage_buckets {
  id                  Int    @id @default(autoincrement())
  cloud_credential_id Int
  endpoint            String
  region              String @default("")
  bucket              String
  path_style          Int    @default(0)
  public_base_url     String @default("")
  extra_config        String @default("{}")
  status              String @default("enabled")
  created_at          Int
  updated_at          Int

  @@unique([cloud_credential_id, endpoint, bucket])
}

model global_cloud_object_storage_bindings {
  id         Int    @id @default(autoincrement())
  site_key   String
  bucket_id  Int
  key_prefix String @default("")
  status     String @default("enabled")
  created_at Int
  updated_at Int

  @@unique([id, site_key])
  @@unique([site_key, bucket_id, key_prefix])
}

model global_cloud_object_storage_binding_purposes {
  binding_id Int
  site_key   String
  purpose    String
  is_default Int @default(0)

  @@id([binding_id, purpose])
}

model global_telegram_bots {
  id               BigInt @id @default(autoincrement())
  name             String @unique
  bot_token        String @unique
  bot_username     String @unique
  secret_token     String
  webhook_hostname String
  status           String @default("enabled")
  created_at       BigInt
  updated_at       BigInt

  @@index([webhook_hostname])
}

model global_cloud_email_channels {
  id                  Int    @id @default(autoincrement())
  cloud_credential_id Int
  region              String
  account_name        String
  from_alias          String
  reply_to_address    Int    @default(0)
  status              String @default("enabled")
  created_at          BigInt
  updated_at          BigInt

  @@unique([cloud_credential_id, region, account_name])
}

model global_cloud_email_templates {
  id            Int    @id @default(autoincrement())
  template_key  String @unique
  template_type String
  name          String
  subject       String
  body_text     String
  body_html     String
  status        String @default("enabled")
  created_at    BigInt
  updated_at    BigInt
}

model global_cloud_email_bindings {
  id         Int    @id @default(autoincrement())
  site_key   String
  channel_id Int
  template_id Int
  purpose    String
  is_default Int    @default(0)
  status     String @default("enabled")
  created_at BigInt
  updated_at BigInt

  @@unique([site_key, channel_id, template_id, purpose])
}

model global_cloud_email_template_publications {
  template_id          Int
  channel_id           Int
  provider_template_id String
  content_hash         String @default("")
  status               String
  created_at           BigInt
  updated_at           BigInt

  @@id([template_id, channel_id])
}
