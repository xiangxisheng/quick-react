datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model passport_users {
  user_id    BigInt @id
  nickname   String
  status     String @default("enabled")
  created_at BigInt
  updated_at BigInt
}

model passport_user_credentials {
  id         BigInt @id @default(autoincrement())
  user_id    BigInt
  password   String
  created_at BigInt

  @@index([user_id, created_at, id])
}

model passport_sessions {
  id         String @id
  user_id    BigInt
  expires_at BigInt
  created_at BigInt

  @@index([user_id])
  @@index([expires_at])
}

model passport_telegram_accounts {
  id               BigInt @id @default(autoincrement())
  user_id          BigInt
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  nickname         String
  created_at       BigInt
  updated_at       BigInt

  @@unique([bot_id, telegram_user_id])
}

model passport_oauth_accounts {
  id               BigInt @id @default(autoincrement())
  user_id          BigInt
  provider         String
  provider_user_id String
  created_at       BigInt
  updated_at       BigInt

  @@unique([provider, provider_user_id])
}

model passport_emails {
  id         BigInt @id @default(autoincrement())
  email      String
  verified   Int    @default(0)
  created_at BigInt
  updated_at BigInt

  @@unique([email])
}

model passport_user_emails {
  user_id    BigInt
  email_id   BigInt
  is_primary Int    @default(0)
  created_at BigInt

  @@id([user_id, email_id])
  @@unique([email_id])
}

model passport_email_otp {
  id               BigInt @id @default(autoincrement())
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  email            String
  code_hash        String
  attempt_count    Int    @default(0)
  status           String @default("pending")
  expires_at       BigInt
  created_at       BigInt

  @@index([bot_id, telegram_user_id, status, created_at])
}

model passport_snowflake_state {
  worker_id      Int    @id
  last_timestamp BigInt
  updated_at     BigInt
}

model passport_telegram_menus {
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  message_id       BigInt
  mode             String
  created_at       BigInt
  updated_at       BigInt

  @@id([bot_id, telegram_user_id])
}

model passport_telegram_updates {
  bot_id     BigInt
  update_id  BigInt
  status     String
  created_at BigInt
  updated_at BigInt

  @@id([bot_id, update_id])
  @@index([status, updated_at])
}

model passport_telegram_identity_choices {
  id               BigInt @id @default(autoincrement())
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  target_user_id   BigInt
  email            String
  status           String
  expires_at       BigInt
  created_at       BigInt
  updated_at       BigInt

  @@index([bot_id, telegram_user_id, status, created_at])
}

model passport_login_challenges {
  id               String @id
  user_id          BigInt
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  expected_number  Int
  status           String
  expires_at       BigInt
  created_at       BigInt
  updated_at       BigInt

  @@index([bot_id, telegram_user_id, status, created_at])
  @@index([status, expires_at])
}

model passport_user_roles {
  user_id    BigInt
  role       String
  created_at BigInt

  @@id([user_id, role])
}

model passport_group_prompts {
  id         BigInt @id @default(autoincrement())
  chat_id    BigInt
  actor_id   BigInt
  state_json String @default("{}")
  expires_at BigInt
  created_at BigInt
  updated_at BigInt

  @@index([chat_id, actor_id, updated_at])
}
