{
	"compilerOptions": {
		"target": "es2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": [
			"dom",
			"es2022"
		],
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": "./",
		"paths": {
			"@/*": [
				"src/*",
			],
			"@server/*": [
				"server/*",
			],
			"@shared/*": [
				"shared/*",
			],
		},
		},
	"include": [
		"src",
		"server",
		"shared"
	],
	"exclude": [
		"docs",
		"dist",
		"node_modules"
	]
}
