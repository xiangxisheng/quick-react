{
	"name": "quick-react",
	"version": "1.0.0",
	"description": "quick react",
	"type": "module",
	"main": "esbuild.cjs",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"build": "node esbuild.cjs",
		"build:worker": "SKIP_SERVER_LISTEN=1 node esbuild.cjs",
		"dev": "node esbuild.cjs --watch --start",
		"start": "node dist/server.mjs",
		"typecheck": "node scripts/generate-worker-registry.cjs && tsc --noEmit",
		"smoke:multi-site": "node scripts/smoke-multi-site.mjs",
		"test:passport-identity": "node scripts/test-passport-identity.mjs",
		"test:passport-login": "node scripts/test-passport-login.mjs",
		"test:passport-migration": "node scripts/test-passport-migration.mjs",
		"test:accounts-oidc": "node scripts/test-accounts-oidc.mjs",
		"import:legacy-passport": "node scripts/import-legacy-passport.mjs",
		"test": "node esbuild.cjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xiangxisheng/quick-react.git"
	},
	"keywords": [
		"react"
	],
	"author": "xixi",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/xiangxisheng/quick-react/issues"
	},
	"homepage": "https://github.com/xiangxisheng/quick-react#readme",
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"antd": "^6.6.0",
		"esbuild": "^0.28.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"hono": "^4.13.2"
	}
}
